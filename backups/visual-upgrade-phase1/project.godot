; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but this file is checked in so the project opens cleanly.
config_version=5

[application]
config/name="MyShop"
config/description="Mobile-first auto repair shop prototype. Phase 2: one garage, one car, one oil change."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=844
window/size/viewport_height=390
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]
pointing/emulate_touch_from_mouse=true

[physics]
3d/physics_engine="Jolt Physics"

[rendering]
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
